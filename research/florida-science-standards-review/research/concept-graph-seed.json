    {
      "id": "concept:genetic-variation",
      "type": "Concept",
      "conceptId": "genetic-variation",
      "text": "Variation in inherited genetic or observable traits within or among offspring in a population."
    },
    {
      "id": "concept:natural-selection",
      "type": "Concept",
      "conceptId": "natural-selection",
      "text": "Environmental conditions cause differential survival and reproduction associated with heritable trait variation, changing trait distributions over generations."
    },
    {
      "id": "concept:adaptation-population-change",
      "type": "Concept",
      "conceptId": "adaptation-population-change",
      "text": "Heritable population characteristics change over time in relation to environmental conditions."
    },
    {
      "id": "concept:fossil-evidence-change-over-time",
      "type": "Concept",
      "conceptId": "fossil-evidence-change-over-time",
      "text": "Fossils provide evidence for changes in organisms and life forms over time."
    },
    {
      "id": "unit:1996:SC.F.2.4.3",
      "type": "TextUnit",
      "code": "SC.F.2.4.3",
      "gradeSpan": "9-12",
      "text": "Understands the mechanisms of change (e.g., mutation and natural selection) that lead to adaptations in a species and their ability to survive naturally in changing conditions and to increase species diversity.",
      "sourceDocument": "doc:fl-science-1996",
      "pageOrAnchor": "SC.F.2.4, Benchmark 3"
    },
    {
      "id": "unit:1996:SC.G.2.4.3",
      "type": "TextUnit",
      "code": "SC.G.2.4.3",
      "gradeSpan": "9-12",
      "text": "Understands how genetic variation of offspring contributes to population control in an environment and that natural selection ensures that those who are best adapted to their surroundings survive to reproduce.",
      "sourceDocument": "doc:fl-science-1996",
      "pageOrAnchor": "SC.G.2.4, Benchmark 3"
    },
    {
      "id": "unit:1996:SC.F.2.3.4",
      "type": "TextUnit",
      "code": "SC.F.2.3.4",
      "gradeSpan": "6-8",
      "text": "Knows that the fossil record provides evidence that changes in the kinds of plants and animals in the environment have been occurring over time.",
      "sourceDocument": "doc:fl-science-1996",
      "pageOrAnchor": "SC.F.2.3, Benchmark 4"
    },
    {
      "id": "unit:gle:SC.F.2.3.4:grade-placement",
      "type": "TextUnit",
      "code": "SC.F.2.3.4",
      "gradeSpan": "6-8",
      "text": "The same fossil-record benchmark is retained; the GLE places its specific expectation at eighth grade.",
      "sourceDocument": "doc:fl-science-gle-1999",
      "pageOrAnchor": "grades 6-8 GLE, SC.F.2.3.4"
    },
    {
      "id": "unit:2008:SC.7.L.15.2",
      "type": "TextUnit",
      "code": "SC.7.L.15.2",
      "gradeSpan": "7",
      "text": "Explore the scientific theory of evolution by recognizing and explaining ways in which genetic variation and environmental factors contribute to evolution by natural selection and diversity of organisms.",
      "sourceDocument": "doc:fl-science-2008",
      "pageOrAnchor": "SC.7.L.15.2"
    },
    {
      "id": "unit:2008:SC.912.L.15.13",
      "type": "TextUnit",
      "code": "SC.912.L.15.13",
      "gradeSpan": "9-12",
      "text": "Describe the conditions required for natural selection, including overproduction of offspring, inherited variation, and the struggle to survive, resulting in differential reproductive success.",
      "sourceDocument": "doc:fl-science-2008",
      "pageOrAnchor": "SC.912.L.15.13"
    },
    {
      "id": "unit:2026:SC.8.SL.2.1",
      "type": "TextUnit",
      "code": "SC.8.SL.2.1",
      "gradeSpan": "8",
      "text": "Recognize the requirements for natural selection to occur in a population.",
      "sourceDocument": "doc:fl-science-2026-draft",
      "pageOrAnchor": "SC.8.SL.2.1"
    },
    {
      "id": "unit:2026:SC.8.SL.2.2",
      "type": "TextUnit",
      "code": "SC.8.SL.2.2",
      "gradeSpan": "8",
      "text": "Explain how inherited traits and variation within a population influence survival and reproduction in changing environments.",
      "sourceDocument": "doc:fl-science-2026-draft",
      "pageOrAnchor": "SC.8.SL.2.2"
    },
    {
      "id": "unit:2026:SC.8.SL.2.3",
      "type": "TextUnit",
      "code": "SC.8.SL.2.3",
      "gradeSpan": "8",
      "text": "Investigate natural selection as a process in which traits in a population may change over time in response to environmental conditions.",
      "sourceDocument": "doc:fl-science-2026-draft",
      "pageOrAnchor": "SC.8.SL.2.3"
    },
    {
      "id": "unit:2026:SC.8.SL.3.2",
      "type": "TextUnit",
      "code": "SC.8.SL.3.2",
      "gradeSpan": "8",
      "text": "Analyze the fossil record to show that life forms have changed over time.",
      "sourceDocument": "doc:fl-science-2026-draft",
      "pageOrAnchor": "SC.8.SL.3.2"
    },

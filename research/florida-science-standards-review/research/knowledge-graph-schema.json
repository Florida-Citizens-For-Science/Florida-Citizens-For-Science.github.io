    "targetUnit": { "@id": "urn:flscience:vocab:targetUnit", "@type": "@id" },
    "unit": { "@id": "urn:flscience:vocab:unit", "@type": "@id" },
    "concept": { "@id": "urn:flscience:vocab:concept", "@type": "@id" },
    "relation": "urn:flscience:vocab:relation",
    "evidence": "urn:flscience:vocab:evidence",
    "sourceDocument": { "@id": "urn:flscience:vocab:sourceDocument", "@type": "@id" },
    "sourceFiles": "urn:flscience:vocab:sourceFiles",
    "pageOrAnchor": "urn:flscience:vocab:pageOrAnchor",
    "confidence": "urn:flscience:vocab:confidence",
    "method": "urn:flscience:vocab:method",
    "status": "urn:flscience:vocab:status",
    "crosswalkNote": "urn:flscience:vocab:crosswalkNote",
    "provenanceStatus": "urn:flscience:vocab:provenanceStatus",
    "provenanceFollowup": "urn:flscience:vocab:provenanceFollowup",
    "sha256": "urn:flscience:vocab:sha256"
  },
  "nodeTypes": ["StandardVersion", "TextUnit", "Concept", "EvidenceAssertion"],
  "relations": [
    "expressesConcept",
    "requiresConcept",
    "exemplifiesConcept",
    "assessesConcept",
    "retainsFrom",
    "revisesFrom",
    "relocatesFrom",
    "splitsFrom",
    "mergesFrom",
    "introducesConcept",
    "evidenceSupports",
    "sourceDocumentOf",
    "candidatePredecessor",
    "possibleOmission",
    "textualLineage",
    "assessmentCrosswalk"
  ],
  "crossVersionStatus": [
    "retained",
    "revised",
    "relocated",
    "split",
    "merged",
    "removed_candidate",
    "introduced_candidate",
    "unresolved"
  ],
  "evidenceMethods": [
    "exact_text_match",
    "near_text_match",
    "conceptual_alignment",
    "explicit_source_citation",
    "version_history",
    "meeting_or_comment_record",
    "human_review"
  ],
  "rules": [
    "Keep original benchmark text and benchmark code on each TextUnit.",
    "Attach grade/course placement to the versioned TextUnit; do not bake grade into the scientific Concept.",
    "Represent each proposed match as an EvidenceAssertion so several possible predecessors can coexist.",
    "Conceptual alignment does not imply textual borrowing or authorship.",
    "provenanceStatus records the evidence state for the drafting source; identified wording lineage does not identify an author, intermediary, or access path.",
    "Use unresolved when matching evidence is insufficient; absence of a match is not proof of deletion.",
    "An assessmentCrosswalk relation records an assessment/report alignment only; it does not assert one-to-one standard equivalence or source authorship."
  ]
}
